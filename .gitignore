# 绝不入库：模型权重、数据集、checkpoint、大文件
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.h5
*.onnx
*.tar
*.tar.gz
*.tgz
*.zip
*.whl

# 数据与输出目录
data/
datasets/
models/
checkpoints/
ckpt/
outputs/
logs/
runs/
wandb/
results/

# ALFWorld / TextWorld 兼容层产物与 --target 装的依赖（体积大、可重建）
third_party/
*.so
*.so.*

# 缓存
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.cache/
.pytest_cache/
*.egg-info/
.mypy_cache/
.ruff_cache/

# 环境
.venv/
venv/
env/
*.env

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
*~
*.swp
# handover 包里的日志与 tar 是**交付物本体**（供外部模型审核），不受上面的通用忽略规则影响
!handover/**/logs/
!handover/**/logs/**
!handover/**/*.tar.gz
