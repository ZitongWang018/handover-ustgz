{
  "workspace_root": "/path/to/ztwang",
  "paths": {
    "hf_checkpoint": "models/Qwen3-4B-Instruct-2507",
    "torch_dist_checkpoint": "models/Qwen3-4B-Instruct-2507_torch_dist",
    "train_jsonl": "handover-ustgz/agentic-coding-rl/data/train.jsonl",
    "eval_jsonl": "handover-ustgz/agentic-coding-rl/data/verified.jsonl",
    "tasks_dir": "handover-ustgz/agentic-coding-rl/data/tasks",
    "run_root": "handover-ustgz/agentic-coding-rl/runs",
    "cache_root": ".cache/swe-rl"
  },
  "model": {
    "megatron_type": "qwen3-4B-Instruct-2507",
    "tito_model": "default",
    "tool_call_parser": "qwen25",
    "reasoning_parser": "",
    "megatron_path": "/root/Megatron-LM"
  },
  "runtime": {
    "image": "radixark/miles:latest",
    "gpus": "0,1,2,3,4,5,6,7",
    "num_gpus": 8,
    "async_actor_gpus": 4,
    "tensor_parallel": 2,
    "pipeline_parallel": 1,
    "context_parallel": 1,
    "expert_parallel": 1,
    "rollout_gpus_per_engine": 1,
    "max_tokens_per_gpu": 8192,
    "sglang_mem_fraction": 0.65,
    "optimizer_cpu_offload": false,
    "ray_port": 16379,
    "ray_dashboard_port": 18265,
    "session_port": 23000,
    "session_workers": 8,
    "router_port": 23100,
    "node_ip": "127.0.0.1",
    "session_external_host": "REPLACE_WITH_HOST_IP_REACHABLE_FROM_TASK_CONTAINERS"
  },
  "agent": {
    "name": "mini-swe-agent",
    "server_url": "http://127.0.0.1:21100",
    "bind_host": "0.0.0.0",
    "port": 21100,
    "max_concurrent": 16,
    "timeout_seconds": 3600,
    "client_timeout_seconds": 7200,
    "task_timeout_seconds": 3000
  },
  "data": {
    "swegym_subset": "lite",
    "train_limit": 0,
    "eval_limit": 0
  },
  "training": {
    "seed": 42,
    "total_trajectories_per_update": 16,
    "group_size": 8,
    "num_rollouts": 100,
    "lr": 0.000001,
    "critic_lr": 0.00001,
    "critic_warmup_rollouts": 1,
    "gamma": 1.0,
    "gae_lambda": 0.95,
    "temperature": 1.0,
    "top_p": 1.0,
    "top_k": -1,
    "max_seq_len": 16384,
    "max_response_len": 2048,
    "clip_low": 0.2,
    "clip_high": 0.28,
    "gspo_clip_low": 0.0003,
    "gspo_clip_high": 0.0004,
    "kl_loss_coef": 0.001,
    "entropy_coef": 0.0,
    "weight_decay": 0.1,
    "save_interval": 10,
    "eval_interval": 20,
    "eval_temperature": 0.0,
    "max_weight_staleness": 4,
    "buffer_capacity_factor": 2.0,
    "tis_clip": 2.0,
    "mis_low": 0.5,
    "mis_high": 5.0,
    "score_centering_top_k": 128,
    "score_centering_is": "mis"
  }
}
